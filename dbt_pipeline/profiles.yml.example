gcp_e2e_pipeline:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: service-account
      project: your-gcp-project-id
      dataset: bronze_transactions  # Default dataset
      threads: 4
      keyfile: path/to/your/gcp-service-account-key.json
      timeout_seconds: 300
      location: us-central1
      priority: interactive
      retries: 1
