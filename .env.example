# ==============================================================================
# GCP-E2E-DATA-PIPELINE ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in the values
# ==============================================================================

# GCP Settings
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# Artifact Registry & Cloud Run
ARTIFACT_REGISTRY_REPO=data-pipeline-repo
INGESTION_IMAGE_NAME=batch-ingestion-service
INGESTION_IMAGE_TAG=latest

# local PostgreSQL Settings (Source DB)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
POSTGRES_DB=transactions_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# BigQuery Settings
BQ_DATASET_BRONZE=bronze_transactions
BQ_DATASET_SILVER=silver_transactions
BQ_DATASET_GOLD=gold_transactions

# Airflow Settings
AIRFLOW_IMAGE_TAG=2.7.1
AIRFLOW_UID=50000
