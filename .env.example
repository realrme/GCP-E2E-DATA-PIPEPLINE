# ==============================================================================
# GCP-E2E-DATA-PIPELINE ENVIRONMENT VARIABLES — EXAMPLE
# Copy this file to .env and fill in your values
# ==============================================================================

# GCP Settings
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# Artifact Registry & Cloud Run
ARTIFACT_REGISTRY_REPO=data-pipeline-repo
INGESTION_IMAGE_NAME=batch-ingestion-service
INGESTION_IMAGE_TAG=latest

# Local PostgreSQL Settings (Source DB — used by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=transactions_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres_source

# BigQuery Dataset IDs
BQ_DATASET_BRONZE=bronze_transactions
BQ_DATASET_SILVER=silver_transactions
BQ_DATASET_GOLD=gold_transactions

# Airflow Settings
AIRFLOW_IMAGE_TAG=2.7.1
AIRFLOW_UID=50000
# Generate your own Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here
