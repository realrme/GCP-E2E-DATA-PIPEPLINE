MANIFEST

# ==============================================================
# Environment Variables & Secrets  ← NEVER commit these
# ==============================================================
.env
.env.*
!.env.example
secrets/
*.pem
*.json
!credentials-example.json
# GCP service account key files (common names)
*-service-account*.json
*-sa-key*.json
application_default_credentials.json

# ==============================================================
# Terraform  ← state files contain resource IDs & secrets
# ==============================================================
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup
*.tfvars
!terraform.tfvars.example

# ==============================================================
# dbt
# ==============================================================
dbt_packages/
dbt_pipeline/logs/
dbt_pipeline/target/
dbt_pipeline/profiles.yml
!dbt_pipeline/profiles.yml.example

# ==============================================================
# Airflow
# ==============================================================
airflow/logs/
airflow/airflow.db
airflow/webserver_config.py

# ==============================================================
# macOS
# ==============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

